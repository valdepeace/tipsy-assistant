# Clave de https://openrouter.ai/keys (este fichero está en .gitignore; no se sube al repo)
OPENROUTER_API_KEY=

# Voz: "openrouter" (nube) o "local" (Qwen3-TTS en tu GPU)
PIRATA_TTS=openrouter
# Rápidos: elevenlabs/eleven-flash-v2.5 (0,4 s), google/gemini-3.8-flash-lite-tts (3 s, admite tono). Lento: bytedance-seed/seed-audio-1-0 (~21 s, clona pirata_ref.wav)
PIRATA_TTS_MODEL=google/gemini-3.8-flash-tts
PIRATA_TTS_VOICE=Charon

# Cerebro del capitán: OpenRouter (usa la misma clave). Comenta estas dos líneas para volver a Ollama local.
PIRATA_LLM_URL=https://openrouter.ai/api/v1
PIRATA_LLM=google/gemini-2.5-flash

# Micrófono (trozos del nombre + API, ver sounddevice.query_devices())
PIRATA_MIC=HyperX MME

# Título del dashboard
PIRATA_TITULO=Compae · el asistente de garrafón

# Oleaje de fondo bajo la voz (0 = sin mar; prueba 0.35 si lo quieres de vuelta)
PIRATA_MAR=0
